{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaTagger",
  "version": "0.1.0",
  "identifier": "com.robheite.mediatagger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaTagger",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "icon": ["icons/icon.ico"],
    "shortDescription": "Scan, tag, de-duplicate, and organize photo and video libraries."
  }
}
